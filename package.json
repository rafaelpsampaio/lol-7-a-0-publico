{
  "name": "lolseteazero",
  "version": "1.0.0",
  "description": "LoL 7 a 0: Draft & Simulador de Pros",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "calibrate": "vitest run -c vitest.calibrate.config.ts",
    "calibrate:micro": "vitest run -c vitest.calibrate-micro.config.ts",
    "calibrate:structures": "vitest run -c vitest.calibrate-structures.config.ts",
    "calibrate:objectives": "vitest run -c vitest.calibrate-objectives.config.ts",
    "calibrate:combat": "vitest run -c vitest.calibrate-combat.config.ts",
    "diagnose": "vitest run -c vitest.diagnose.config.ts",
    "probe:side-bias": "vitest run -c vitest.probe-side-bias.config.ts",
    "probe:shape": "vitest run -c vitest.probe-shape.config.ts",
    "probe:lift": "vitest run -c vitest.probe-lift.config.ts",
    "calibrate:pace": "vitest run -c vitest.calibrate-pace.config.ts",
    "calibrate:assists": "vitest run -c vitest.calibrate-assists.config.ts",
    "realism": "tsx scripts/realism-audit.ts",
    "calibrate:traits": "tsx scripts/calibrate-traits.ts",
    "calibrate:realism": "vitest run -c vitest.calibrate-realism.config.ts",
    "mutation:maxcasualties": "vitest run -c vitest.mutation.config.ts",
    "calibrate:all": "node scripts/calibrate-all.mjs",
    "diff-golden": "node scripts/diff-golden.ts",
    "update-golden": "vitest run src/__tests__/golden/golden.test.ts --update",
    "server": "tsx server/main.ts",
    "play": "npm run build && npm run server",
    "play:online": "npm run build && npm run server -- --tunnel --host-auto",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "pack:amigos": "tsx scripts/importar-amigos.ts",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@solid-primitives/storage": "^4.3.4",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.61.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sirv": "^3.0.2",
    "solid-js": "^1.9.13",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
